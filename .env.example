# Скопируйте этот файл в .env и впишите свой ключ:
#   cp .env.example .env
#
# .env добавлен в .gitignore и в репозиторий не попадёт.
# Проверить, что ключ виден агенту: python cli.py --файл samples/договор-лицензии.docx

# --- ключ доступа к модели ---------------------------------------------------
# Агент ищет ключ так: сначала LLM_API_KEY, а если он пуст — переменную того
# провайдера, чей адрес указан в LLM_BASE_URL. Поэтому достаточно заполнить
# либо LLM_API_KEY, либо переменную нужного провайдера.

LLM_API_KEY=

# Groq — бесплатный тариф, модель по умолчанию. Ключ: https://console.groq.com/keys
GROQ_API_KEY=your-groq-key-here

# DeepSeek — платный. Ключ: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# z.ai (GLM) — бесплатная glm-4.5-flash. Ключ: https://z.ai/manage-apikey/apikey-list
ZAI_API_KEY=

# --- модель ------------------------------------------------------------------
# Модель выбирается ключом из каталога agent/catalog.py; адрес провайдера и
# нужная переменная с ключом подставляются оттуда же. Посмотреть список:
#   python cli.py --help
# Доступны: groq-120b, groq-20b, groq-qwen27b, glm-flash, ds-flash, ds-pro.
# Сменить модель можно и на лету: python cli.py --модель ds-pro
LLM_MODEL_KEY=groq-120b

# Низкая температура: разбор документа должен быть предсказуемым.
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=120

# --- правила учёта -----------------------------------------------------------
# Лимит стоимости организация устанавливает сама в учётной политике
# (п. 7 ФСБУ 14/2022). Ниже лимита объект в НМА не попадёт.
COST_LIMIT=100000

# Ограничения на входные данные.
MAX_FILE_SIZE_MB=10
MAX_TEXT_LENGTH=12000

# --- память диалога ----------------------------------------------------------
# История хранится в SQLite и переживает перезапуск. Файл создаётся сам.
HISTORY_DB=history.db

# Сколько истории уходит в модель. Ограничения работают вместе: по числу
# сообщений — чтобы разговор не разрастался, по символам — чтобы одна огромная
# реплика не съела весь контекст.
MAX_HISTORY_MESSAGES=20
MAX_HISTORY_CHARS=12000

# --- токены и переполнение контекста -----------------------------------------
# Что делать, когда разговор перестаёт помещаться в окно модели:
#   обрезать  — выбросить давние реплики и продолжить (по умолчанию);
#   отказать  — остановиться и объяснить, чего не хватает;
#   отправить — отправить как есть; ошибку вернёт провайдер (режим для опытов).
ON_OVERFLOW=обрезать

# Сколько токенов просить у модели под ответ. Агент не даст зарезервировать
# больше половины контекстного окна, иначе на маленьких моделях под сам вопрос
# не останется места.
LLM_MAX_TOKENS=4096

# --- сжатие истории ----------------------------------------------------------
# Давние реплики заменяются краткой выжимкой, свежие уходят дословно.
# 0 или «нет» полностью выключает механизм.
COMPRESS_HISTORY=1

# Модель, которая делает выжимку. Работа механическая, поэтому по умолчанию
# берётся дешёвая и быстрая — на платной основной модели сжатие съедало бы
# часть той экономии, ради которой всё затевается.
SUMMARIZER_MODEL=groq-20b

# Сколько последних сообщений всегда остаются дословными: в них уточнения
# и местоимения, без которых разговор рассыпается.
KEEP_LAST_MESSAGES=6

# Сжатие запускается по тому из двух условий, что наступит раньше:
# накопилось столько состарившихся сообщений либо история заняла такую долю
# доступного контекста.
COMPRESS_EVERY=10
COMPRESS_THRESHOLD=0.5

# Предел длины самой выжимки, иначе она разрастётся до размеров истории.
SUMMARY_TOKENS=400
